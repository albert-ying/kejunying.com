{"schemaVersion":1,"buildId":"f23bc85995440832e2b6","key":"cv-069","recordId":"cv-069","kind":"paper","lang":"en","title":"Precious3GPT: Multimodal Multi-Species Multi-Omics Multi-Tissue Transformer for Aging Research and Drug Discovery","canonicalPath":"/papers/cv-069/","fields":{"venue":"bioRxiv","year":2024,"yearLabel":null,"status":"preprint","statusNote":null,"title":"Precious3GPT: Multimodal Multi-Species Multi-Omics Multi-Tissue Transformer for Aging Research and Drug Discovery","authors":"Galkin, F., ..., Tyshkovskiy, A., Ying, K., Gladyshev, V. N., & Zhavoronkov, A.","doi":"10.1101/2024.07.25.605062","link":"https://doi.org/10.1101/2024.07.25.605062","description":"Precious3GPT combines textual, tabular and knowledge graph representations of biological experiments across species, tissues and omics modalities. The model supports tasks including age prediction, sample classification and prediction of molecular responses to compounds.","descriptions":[{"sourceField":"finding","text":"Precious3GPT combines textual, tabular and knowledge graph representations of biological experiments across species, tissues and omics modalities. The model supports tasks including age prediction, sample classification and prediction of molecular responses to compounds."}],"abstract":null,"descriptionHeading":null,"descriptionSource":{"doi":"10.1101/2024.07.25.605062","pmid":null,"source":"Crossref abstract","snapshot":"paper-abstracts-2026-11-13.json","retrieved":"2026-11-13"},"pdfDocument":{"available":true,"sourceURL":"https://doi.org/10.1101/2024.07.25.605062","openPaperHref":"https://doi.org/10.1101/2024.07.25.605062","displayPolicy":"all-pages","rightsDecision":false,"identityDecision":false,"version":"preprint","licence":"CC-BY-NC-ND","pageCount":39,"renderedPages":39,"readingWidth":2048,"loupe":{"mode":"magnify-same-image","factor":2},"manifestHref":"/content/papers/cv-069.json"},"pdfFigures":[{"figureNumber":1,"href":"/assets/papers/cv-069/figure-01.webp","legendFirstSen